APP_NAME=Savidya Higher Education Institute
INSTITUTE_TAGLINE="Empowering minds, shaping futures through excellence in education"
INSTITUTE_LOGO="logo/logo.png"
APP_VERSION=3.0.0
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Landing page "Open demo" button (empty DEMO_URL = this system's login page)
DEMO_URL=
DEMO_EMAIL=
DEMO_PASSWORD=

# First install: super admin created by `php artisan nexora:deploy`
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=

# Database backup / restore (empty = mysqldump / mysql on the PATH)
MYSQLDUMP_PATH=
MYSQL_CLIENT_PATH=

# Parent API (/api/parent/v1). Login returns data.token; apps send "Authorization: Bearer <token>".
# Set to true once the parent app and the Parent Hub send the token (old apps stop working then).
PARENT_API_REQUIRE_TOKEN=false
PARENT_API_TOKEN_DAYS=90
PARENT_API_LOGIN_ATTEMPTS=10
